{
  "name": "rookeepa",
  "version": "0.1.0",
  "private": false,
  "description": "Free, open-source, local-first bookkeeping for small business — invoices, bills, bank reconciliation, GST and financial reports, running entirely in your browser.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "node scripts/lint-imports.mjs && node --test tests/*.test.mjs",
    "lint": "node scripts/lint-imports.mjs",
    "smoke": "node scripts/smoke.mjs",
    "bench": "node scripts/bench.mjs",
    "check:links": "node scripts/check-links.mjs",
    "serve": "python3 -m http.server 5173",
    "serve:node": "npx --yes serve -l 5173 .",
    "publish:github": "bash scripts/publish.sh"
  },
  "keywords": ["accounting", "bookkeeping", "invoicing", "gst", "bas", "small-business", "local-first", "offline", "reconciliation", "ledger"],
  "engines": { "node": ">=18" }
}
